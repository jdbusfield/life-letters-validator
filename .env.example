OPENAI_API_KEY=your-openai-api-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=your-admin-password
SESSION_SECRET=random-session-secret

# Address used in private customer survey links (no trailing path).
PUBLIC_BASE_URL=https://life-letters-survey.onrender.com
# Require a private per-set link for uploads and final submission.
REQUIRE_SURVEY_ACCESS=true

# Paid Shopify orders -> one survey per purchased set -> transactional email.
# Keep disabled until the database migration, signing secret, sender verification,
# and a controlled end-to-end test are complete.
SHOPIFY_AUTOMATION_ENABLED=false
SHOPIFY_SHOP_DOMAIN=0wvdff-u1.myshopify.com
SHOPIFY_SURVEY_PRODUCT_IDS=9346367193256
SHOPIFY_WEBHOOK_SECRET=your-store-webhook-signing-secret
SURVEY_LINK_SECRET=replace-with-a-separate-random-secret-at-least-32-characters-long
RESEND_API_KEY=your-resend-sending-key
SURVEY_EMAIL_FROM=Life Letters <cards@mail.life-letters.com>
SURVEY_EMAIL_REPLY_TO=lifelettersco@gmail.com
SHOPIFY_ACCEPT_TEST_ORDERS=false

# Photo upload quality gate (optional)
# Minimum pixels on the shortest side; uploads smaller than this are rejected as
# low-resolution. Set to 0 to disable the resolution check.
PHOTO_MIN_DIMENSION=500
# Set to "true" to reject any photo that can't have a transparent background
# (e.g. JPEGs). Leave false if customers upload normal photos of people/pets.
PHOTO_REQUIRE_TRANSPARENT=false
