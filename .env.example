ANTHROPIC_API_KEY=your-anthropic-api-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=your-admin-password
SESSION_SECRET=random-session-secret

# Photo upload quality gate (optional)
# Minimum pixels on the shortest side; uploads smaller than this are rejected as
# low-resolution. Set to 0 to disable the resolution check.
PHOTO_MIN_DIMENSION=500
# Set to "true" to reject any photo that can't have a transparent background
# (e.g. JPEGs). Leave false if customers upload normal photos of people/pets.
PHOTO_REQUIRE_TRANSPARENT=false
